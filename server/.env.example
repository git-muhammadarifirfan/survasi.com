# ══════════════════════════════════════════════════════════════════
# BSAN JATIM MONITORING — Backend API Environment Variables
# ══════════════════════════════════════════════════════════════════
# Copy file ini ke `.env` dan isi dengan nilai yang sesuai.
# JANGAN commit file .env ke git!

# ─── MySQL Database ─────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=3306
DB_USER=bsan_user
DB_PASS=ganti_password_aman
DB_NAME=bsan_jatim_monitoring

# ─── JWT Auth ───────────────────────────────────────────────────
# Buat random string 64+ karakter. Gunakan: node -e "require('crypto').randomBytes(64).toString('hex') |> console.log"
JWT_SECRET=ganti_dengan_secret_random_yang_panjang_dan_aman
JWT_EXPIRES_IN=8h

# ─── Server ─────────────────────────────────────────────────────
PORT=3001
NODE_ENV=production

# ─── CORS ───────────────────────────────────────────────────────
# Origin frontend yang diizinkan (pisahkan dengan koma jika banyak)
CORS_ORIGINS=http://localhost:5173,https://survasi.com
